# https://editorconfig.org — 팀·OS 공통 스타일 (PR diff 최소화)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{dart,yml,yaml,json,jsonc,gradle}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
